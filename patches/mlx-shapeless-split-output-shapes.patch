@@ -5316,6 +5316,20 @@ bool Split::is_equivalent(const Primitive& other) const {
   return axis_ == s_other.axis_ && indices_ == s_other.indices_;
 }
 
+std::vector<Shape> Split::output_shapes(const std::vector<array>& inputs) {
+  const auto& input_shape = inputs.at(0).shape();
+  std::vector<Shape> shapes(indices_.size() + 1, input_shape);
+  if (indices_.empty()) {
+    return shapes;
+  }
+  shapes[0][axis_] = indices_[0];
+  for (int i = 1; i < indices_.size(); ++i) {
+    shapes[i][axis_] = indices_[i] - indices_[i - 1];
+  }
+  shapes.back()[axis_] = input_shape[axis_] - indices_.back();
+  return shapes;
+}
