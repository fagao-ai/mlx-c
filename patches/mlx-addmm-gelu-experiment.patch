+template <typename OutT, typename InT>
+struct TransformGeluApproximate {
+  static METAL_FUNC OutT apply(InT x) {
+    const float xf = static_cast<float>(x);
+    const float x3 = xf * xf * xf;
+    const float inner = 0.7978845608028654f * (xf + 0.044715f * x3);
+    return static_cast<OutT>(0.5f * xf * (1.0f + metal::precise::tanh(inner)));
+  }
+};
